func main() {
	fmt.Println("main started")
	channel := make(chan string)

	// go another_function(channel)
	go func() {
		fmt.Println("anonymous function function goroutine started")
		channel <- string("ping")
	}()

	fmt.Println("main received from channel: ", <-channel)

}
